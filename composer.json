{
    "name": "simp/pindrop",
    "description": "Pindrop CMS project for building PHP websites",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Simp\\Pindrop\\": "pindrop/",
            "Simp\\Pindrop\\Modules\\": "modules/",
            "Simp\\Pindrop\\Services\\": "services/",
            "Simp\\Pindrop\\Controllers\\": "controllers/",
            "Simp\\Pindrop\\Helpers\\": "helpers/",
            "Simp\\Pindrop\\Exceptions\\": "exceptions/",
            "Simp\\Pindrop\\Plugins\\": "plugins/"
        }
    },
    "authors": [
        {
            "name": "CHANCENY",
            "email": "nyasuluchance6@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "commerceguys/addressing": "^2.2",
        "dragonmantank/cron-expression": "^3.6",
        "endroid/qr-code": "^6.1",
        "filp/whoops": "^2.18",
        "giggsey/libphonenumber-for-php": "^9.0",
        "minishlink/web-push": "^10.0",
        "mpdf/mpdf": "^8.3",
        "php-di/php-di": "^7.1",
        "phpmailer/phpmailer": "^7.0",
        "pragmarx/google2fa": "^9.0",
        "react/socket": "^1.17.0",
        "shuchkin/simplecsv": "^1.0",
        "shuchkin/simplexls": "^1.0",
        "shuchkin/simplexlsx": "^1.1",
        "shuchkin/simplexlsxgen": "^1.5",
        "simp/router": "^1.1.5",
        "simp/streamwrapper": "^1.0",
        "simp/translate": "^1.0",
        "symfony/mime": "^8.0",
        "symfony/var-dumper": "^8.0",
        "symfony/yaml": "^7.2",
        "twig/twig": "^3.0"
    },
    "scripts": {
        "post-install-cmd": [
            "php cli/composer.php"
        ],
        "post-update-cmd": [
            "php cli/composer.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}