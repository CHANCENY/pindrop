ROOT="/app"
CONFIG="[ROOT]/config/sync"
PLUGIN_ROOT="[ROOT]/modules"
THEMES_DIR="[ROOT]/themes"
PUBLIC_STREAM="public://"
PUBLIC_STREAM_DIR="[ROOT]/sites/default/files"
PUBLIC_WEB_FILE_ROOT="/sites/default/files/"
LOG_FILE=[ROOT]/.logs/reports.log
LOG_ENABLED="true"
LOG_DRIVER="file"
APP_NAME="PINDROP CMS"
SIDEBAR_OFF=0

# Database settings
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Persistent DB connections — reuses the same MySQL socket across requests
# instead of opening a new TCP connection each time.
# Benefit : removes ~1-5ms TCP handshake overhead per request under load.
# WARNING : set to true ONLY when running a single PHP-FPM worker pool on one
#           server.  On multiple servers or with connection poolers (ProxySQL,
#           PgBouncer) leave this false — persistent connections bypass the
#           pooler and can exhaust MySQL's max_connections.
# WARNING : never use true with mysql_attr_init_command — charset is set via
#           explicit SET NAMES in Database::connect() instead.
DB_PERSISTENT=false

# SMTP SETTINGS
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="ssl"
SMTP_PORT=465
SMTP_DEBUG=0
MAIL_FROM_EMAIL="[SMTP_USER]"


# BASIC SETTING

# change to production to enable:
#  - DI container compilation cache (var/cache/di/)
#  - Plugin YAML manifest cache    (var/cache/plugins/)
#  - Theme YAML manifest cache     (var/cache/themes/)
# After each deploy run:
#   php -r "require 'vendor/autoload.php'; \Simp\Pindrop\Services\ServiceProvider::clearContainerCache();"
# and delete var/cache/plugins/ and var/cache/themes/ to force a rebuild.
APP_ENV="development"

# Twig template cache — auto-enabled when APP_ENV=production.
# Compiled templates are stored in var/cache/twig/ and OPcache holds them in
# memory.  Delete var/cache/twig/ after deploying template changes.
# TWIG_CACHE=true          # force-enable even in development
# TWIG_CACHE=false         # force-disable even in production
# TWIG_CACHE_PATH="/app/var/cache/twig"  # override default location

# Override the default var/cache directory (optional)
# CACHE_DIR="/app/var/cache" 
DEBUG="FALSE"
CSRF_TOKEN_SECRET="X80OCLQQD2LXUEPWS49LH2AWZ67EHPNV"

# SOCKET SETTINGS
SOCKET_HOST="0.0.0.0"
SOCKET_PORT=8000
SOCKET_ACTIVATED=FALSE