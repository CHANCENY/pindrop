ROOT="/app"
CONFIG="[ROOT]/config/sync"
PLUGIN_ROOT="[ROOT]/modules"
THEMES_DIR="[ROOT]/themes"
PUBLIC_STREAM="public://"
PUBLIC_STREAM_DIR="[ROOT]/sites/default/files"
LOG_FILE=[ROOT]/.logs/reports.log
LOG_ENABLED="true"
LOG_DRIVER="file"
