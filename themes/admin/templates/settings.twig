{% extends "templates/base.twig" %}

{% block title %}Settings{% endblock %}

{% block content %}
<div class="admin-page">
    <div class="admin-page-header">
        <h2 class="admin-page-title">Settings</h2>
        <p class="admin-page-description">Configure your application settings</p>
    </div>

    <form method="POST" class="admin-form">
        <fieldset class="admin-section">
            <legend class="admin-section-title">General Settings</legend>
            <div class="admin-form-group">
                <label for="site_home" class="admin-form-label">Site Home Route</label>
                <input type="text" id="site_home" name="site_home" value="{{ site_home }}" class="admin-form-input">
                <p class="admin-form-help">Administrative email address</p>
            </div>
        </fieldset>

        {% for handlersValidated in handlersValidateds %}

            <fieldset class="admin-section">
                <legend class="admin-section-title">{{ handlersValidated.name }}</legend>
                {{ handlersValidated.object.formBuild(request, handlersValidated.setting)|raw }}
            </fieldset>

        {% endfor %}

        <div class="admin-actions">
            <button type="submit" class="admin-button admin-button-primary">Save Settings</button>
            <a href="/" class="admin-button admin-button-secondary">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}

    <script>
        document.addEventListener('DOMContentLoaded',()=>{
            const titleAutoComplete = new Autocomplete({
                fieldId: 'site_home',
                source: 'autocomplete.route.search',
                placeholder: 'Search routes..',
                minQueryLength: 2,
                limit: 10,
                displayField: 'label',
                valueField: 'value',
                searchFields: ['title', 'id'],
                noResultsText: 'No route path',
                loadingText: 'Searching...',
                name: 'site_home'
            });

        })
    </script>

{% endblock %}
