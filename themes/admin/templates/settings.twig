{% extends "templates/base.twig" %}

{% block title %}Settings{% endblock %}

{% block head %}

    <style>
        /* Scoped Drupal-like Settings Grid Layout */

        .drupal-settings-container {
            --drupal-border-color: #d3d3d3;
            --drupal-bg-header: #f1f1f1;
            --drupal-bg-stripe: #f9f9f9;
            --drupal-primary-color: #007bff;
            --drupal-text-color: #333;

            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--drupal-text-color);
            margin: 20px auto;
            box-sizing: border-box;
        }

        .drupal-settings-container *,
        .drupal-settings-container *::before,
        .drupal-settings-container *::after {
            box-sizing: inherit;
        }

        /* Page Header */
        .drupal-settings-container .page-header {
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--drupal-border-color);
            padding-bottom: 1rem;
        }

        .drupal-settings-container .page-header h1 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .drupal-settings-container .page-header p {
            color: #666;
            margin-top: 5px;
        }

        /* TWO-COLUMN SIDE-BY-SIDE GRID FOR FIELDSETS */
        .drupal-settings-container .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Side by side two grids */
            gap: 25px;
            margin-bottom: 2rem;
        }

        /* FIELDSET STYLING */
        .drupal-settings-container fieldset {
            border: 1px solid var(--drupal-border-color);
            background: #fff;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .drupal-settings-container legend {
            background: var(--drupal-bg-header);
            padding: 10px 15px;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--drupal-border-color);
            width: 100%;
            color: #555;
            float: left; /* Fix for some browsers to make it span full width */
        }

        /* INTERNAL FORM GRID (Within fieldset) */
        .drupal-settings-container .fieldset-content {
            display: grid;
            grid-template-columns: repeat(2, 1fr); /* 2 columns inside each fieldset */
            width: 100%;
            gap: 11px;
            margin: 10px;
        }

        .drupal-settings-container .form-item {
            border-right: 1px solid var(--drupal-border-color);
            border-bottom: 1px solid var(--drupal-border-color);
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .drupal-settings-container .fieldset-content > .form-item:nth-child(2n) {
            border-right: none;
        }

        .drupal-settings-container .full-width {
            grid-column: span 2;
            border-right: none;
        }

        /* FORM ELEMENTS */
        .drupal-settings-container label {
            font-weight: 700;
            font-size: 0.85rem;
            color: #555;
        }

        .drupal-settings-container input,
        .drupal-settings-container select,
        .drupal-settings-container textarea {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 2px;
            font-size: 0.9rem;
            width: 100%;
        }

        .drupal-settings-container .help-text {
            font-size: 0.75rem;
            color: #777;
            font-style: italic;
        }

        /* ACTIONS */
        .drupal-settings-container .form-actions {
            display: flex;
            gap: 10px;
            padding: 20px 0;
            border-top: 1px solid var(--drupal-border-color);
        }

        .drupal-settings-container .btn {
            padding: 10px 20px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            border: 1px solid #ccc;
            font-size: 0.9rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            background: #fff;
            color: #333;
        }

        .drupal-settings-container .btn-primary {
            background-color: var(--drupal-primary-color);
            color: white;
            border-color: var(--drupal-primary-color);
        }

        /* Responsive */
        @media (max-width: 992px) {
            .drupal-settings-container .settings-grid {
                grid-template-columns: 1fr;
            }
        }

    </style>

{% endblock %}

{% block content %}
    <div class="drupal-settings-container">

        <!-- Page Header -->
        <div class="page-header">
            <h1>Settings</h1>
            <p>Configure your application settings</p>
        </div>

        <form method="POST" action="" enctype="multipart/form-data">

            <!-- TWO-COLUMN SIDE-BY-SIDE GRID FOR FIELDSETS -->
            <div class="settings-grid">

                <!-- General Settings Section (Example of a manually defined fieldset) -->
                <fieldset class="node-section">
                    <legend>General Settings</legend>
                    <div class="fieldset-content">
                        <div class="form-item full-width">
                            <label for="site_home">Site Home Route</label>
                            <input type="text" id="site_home" name="site_home" value="{{ site_home }}" placeholder="e.g. /home">
                            <small class="help-text">Administrative email address</small>
                        </div>
                    </div>
                </fieldset>

                <!-- DYNAMIC HANDLER FIELDSETS -->
                {% for handlersValidated in handlersValidateds %}
                    <fieldset class="node-section">
                        <legend>{{ handlersValidated.name }}</legend>
                        <div class="fieldset-content">
                            {# Assuming formBuild returns the inner fields with .form-item classes #}
                            {{ handlersValidated.object.formBuild(request, handlersValidated.setting)|raw }}
                        </div>
                    </fieldset>
                {% endfor %}

            </div>

            <!-- FORM ACTIONS -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Settings</button>
                <a href="#" class="btn">Cancel</a>
            </div>

        </form>

    </div>

<noscript autocomplete='true' style="display:none;">
{
  "fieldId": "site_home",
  "source": "autocomplete.route.search",
  "placeholder": "Search routes..",
  "minQueryLength": 2,
  "limit": 10,
  "displayField": "label",
  "valueField": "value",
  "searchFields": [
    "title",
    "id"
  ],
  "noResultsText": "No route path",
  "loadingText": "Searching...",
  "name": "site_home",
  "onSelect": null
}
</noscript>


{% endblock %}

