{% extends "templates/base.twig" %}

{% block title %}Settings{% endblock %}

{% block content %}
<div class="admin-page">
    <div class="admin-page-header">
        <h2 class="admin-page-title">Settings</h2>
        <p class="admin-page-description">Configure your application settings</p>
    </div>

    <form method="POST" class="admin-form">
        <div class="admin-section">
            <h3 class="admin-section-title">General Settings</h3>
            
            <div class="admin-form-group">
                <label for="site_name" class="admin-form-label">Site Name</label>
                <input type="text" id="site_name" name="site_name" value="{{ settings.site_name }}" class="admin-form-input">
                <p class="admin-form-help">The name of your website or application</p>
            </div>

            <div class="admin-form-group">
                <label for="site_email" class="admin-form-label">Site Email</label>
                <input type="email" id="site_email" name="site_email" value="{{ settings.site_email }}" class="admin-form-input">
                <p class="admin-form-help">Administrative email address</p>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">
                    <input type="checkbox" name="maintenance_mode" {{ settings.maintenance_mode ? 'checked' : '' }} class="admin-form-checkbox">
                    Maintenance Mode
                </label>
                <p class="admin-form-help">Enable to show maintenance page to visitors</p>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">
                    <input type="checkbox" name="debug_mode" {{ settings.debug_mode ? 'checked' : '' }} class="admin-form-checkbox">
                    Debug Mode
                </label>
                <p class="admin-form-help">Enable debug information and error reporting</p>
            </div>
        </div>

        <div class="admin-section">
            <h3 class="admin-section-title">Theme Settings</h3>
            
            <div class="admin-form-group">
                <label for="default_theme" class="admin-form-label">Default Theme</label>
                <select id="default_theme" name="default_theme" class="admin-form-select">
                    <option value="admin" selected>Admin</option>
                    <!-- Add more themes as they become available -->
                </select>
                <p class="admin-form-help">Select the default theme for your application</p>
            </div>
        </div>

        <div class="admin-actions">
            <button type="submit" class="admin-button admin-button-primary">Save Settings</button>
            <a href="/" class="admin-button admin-button-secondary">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
