{% extends "templates/base.twig" %}

{% block title %}Content{% endblock %}

{% block head %}

    <style>
        .admin-content-table-wrapper {
            width: 100%;
            overflow-x: auto;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .admin-content-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
            font-size: 14px;
        }

        .admin-content-table thead {
            background: #f5f7fa;
        }

        .admin-content-table th {
            text-align: left;
            padding: 14px 16px;
            font-weight: 600;
            color: #444;
            border-bottom: 1px solid #e5e7eb;
        }

        .admin-content-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: top;
        }

        .admin-content-table tbody tr:hover {
            background: #fafafa;
        }

        .admin-content-excerpt {
            margin-top: 5px;
            font-size: 12px;
            color: #777;
        }

        /* Status badges */
        .admin-content-status {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            display: inline-block;
        }

        .admin-status-published {
            background: #e6f7ee;
            color: #1f9d55;
        }

        .admin-status-draft {
            background: #fff4e5;
            color: #d9822b;
        }

        .admin-status-archived {
            background: #f1f1f1;
            color: #666;
        }

        /* Links */
        .admin-link {
            margin-right: 10px;
            text-decoration: none;
            color: #2563eb;
            font-weight: 500;
        }

        .admin-link:hover {
            text-decoration: underline;
        }

        /* Responsive tweaks */
        @media (max-width: 768px) {
            .admin-content-table {
                font-size: 13px;
            }

            .admin-content-excerpt {
                display: none; /* hide excerpt on small screens */
            }
        }
    </style>

{% endblock %}

{% block content %}
<div class="admin-page">
    <div class="admin-page-header">
        <h2 class="admin-page-title">Content</h2>
        <p class="admin-page-description">Manage your website content and pages</p>
        <div class="admin-page-actions">
            <a href="/admin/content/create" class="admin-button admin-button-primary">
                <i class="admin-icon-plus"></i> Create Content
            </a>
        </div>
    </div>

    <!-- Search and Filters -->
    <form method="GET" class="admin-filters">
        <div class="admin-search">
            <input type="text" name="search" placeholder="Search content..." value="{{ filters.search }}" class="admin-search-input">
            <button type="submit" class="admin-search-button">
                <i class="admin-icon-search"></i>
            </button>
        </div>
        
        <div class="admin-filter-group">
            <select name="type" class="admin-filter-select">
                <option value="">All Types</option>
                {% for content_type in content_types %}
                <option value="{{ content_type.name }}" {% if filters.type == content_type.name %}selected{% endif %}>
                    {{ content_type.label }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="admin-filter-group">
            <select name="status" class="admin-filter-select">
                <option value="">All Status</option>
                <option value="published" {% if filters.status == 'published' %}selected{% endif %}>Published</option>
                <option value="draft" {% if filters.status == 'draft' %}selected{% endif %}>Draft</option>
                <option value="archived" {% if filters.status == 'archived' %}selected{% endif %}>Archived</option>
            </select>
        </div>

        <div class="admin-filter-group">
            <select name="limit" class="admin-filter-select">
                <option value="10" {% if filters.limit == 10 %}selected{% endif %}>10 per page</option>
                <option value="20" {% if filters.limit == 20 %}selected{% endif %}>20 per page</option>
                <option value="50" {% if filters.limit == 50 %}selected{% endif %}>50 per page</option>
                <option value="100" {% if filters.limit == 100 %}selected{% endif %}>100 per page</option>
            </select>
        </div>

        <button type="submit" class="admin-button admin-button-secondary">Apply Filters</button>
        <a href="/admin/content" class="admin-button admin-button-outline">Clear</a>
    </form>

    <!-- Content Table -->
    <div class="admin-content-table-wrapper">
        <table class="admin-content-table">
            <thead>
            <tr>
                <th>Title</th>
                <th>Type</th>
                <th>Status</th>
                <th>Published</th>
                <th>Author</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for item in content %}
                <tr>
                    <td>
                        <strong>{{ item.title }}</strong>
                        <p class="admin-content-excerpt">{{ item.excerpt }}</p>
                    </td>
                    <td>{{ item.type }}</td>
                    <td>
                    <span class="admin-content-status admin-status-{{ item.status|lower }}">
                        {{ item.status }}
                    </span>
                    </td>
                    <td>{{ item.published }}</td>
                    <td>{{ item.author }}</td>
                    <td>{{ item.created_at|date("M j, Y") }}</td>
                    <td>
                        <a href="/admin/content/{{ item.id }}/edit" class="admin-link">Edit</a>
                        <a href="/content/{{ item.slug|default(item.id) }}" class="admin-link">View</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    {% if content|length == 0 %}
    <div class="admin-empty-state">
        <div class="admin-empty-icon">
            <i class="admin-icon-content"></i>
        </div>
        <h3 class="admin-empty-title">No content found</h3>
        <p class="admin-empty-description">
            {% if filters.search or filters.type or filters.status %}
                Try adjusting your filters or search terms.
            {% else %}
                Get started by creating your first piece of content.
            {% endif %}
        </p>
        {% if not filters.search and not filters.type and not filters.status %}
        <a href="/admin/content/create" class="admin-button admin-button-primary">
            <i class="admin-icon-plus"></i> Create Content
        </a>
        {% endif %}
    </div>
    {% endif %}

    <!-- Pagination -->
    {% if pagination.total_items > 0 %}
    <div class="admin-pagination">
        <div class="admin-pagination-info">
            Showing {{ pagination.showing_start }}-{{ pagination.showing_end }} of {{ pagination.total_items }} items
        </div>
        <div class="admin-pagination-controls">
            {% if pagination.has_previous %}
                <a href="?page={{ pagination.previous_page }}&type={{ filters.type }}&status={{ filters.status }}&search={{ filters.search }}&limit={{ filters.limit }}" class="admin-pagination-button">Previous</a>
            {% else %}
                <button class="admin-pagination-button" disabled>Previous</button>
            {% endif %}
            
            {# Generate page numbers #}
            {% set start_page = max(1, pagination.current_page - 2) %}
            {% set end_page = min(pagination.total_pages, pagination.current_page + 2) %}
            
            {% if start_page > 1 %}
                <a href="?page=1&type={{ filters.type }}&status={{ filters.status }}&search={{ filters.search }}&limit={{ filters.limit }}" class="admin-pagination-button">1</a>
                {% if start_page > 2 %}
                    <span class="admin-pagination-ellipsis">...</span>
                {% endif %}
            {% endif %}
            
            {% for page in range(start_page, end_page) %}
                {% if page == pagination.current_page %}
                    <button class="admin-pagination-button admin-pagination-active">{{ page }}</button>
                {% else %}
                    <a href="?page={{ page }}&type={{ filters.type }}&status={{ filters.status }}&search={{ filters.search }}&limit={{ filters.limit }}" class="admin-pagination-button">{{ page }}</a>
                {% endif %}
            {% endfor %}
            
            {% if end_page < pagination.total_pages %}
                {% if end_page < pagination.total_pages - 1 %}
                    <span class="admin-pagination-ellipsis">...</span>
                {% endif %}
                <a href="?page={{ pagination.total_pages }}&type={{ filters.type }}&status={{ filters.status }}&search={{ filters.search }}&limit={{ filters.limit }}" class="admin-pagination-button">{{ pagination.total_pages }}</a>
            {% endif %}
            
            {% if pagination.has_next %}
                <a href="?page={{ pagination.next_page }}&type={{ filters.type }}&status={{ filters.status }}&search={{ filters.search }}&limit={{ filters.limit }}" class="admin-pagination-button">Next</a>
            {% else %}
                <button class="admin-pagination-button" disabled>Next</button>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
