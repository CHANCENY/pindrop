{% extends "templates/base.twig" %}

{% block title %}{{ page_title }}{% endblock %}

{% block head %}

    <style>
        /**
 * Drupal 9 Inspired Compact Admin Form CSS
 *
 * Features:
 * - Two-column layout (Left: Main Content, Right: Settings)
 * - Compact spacing (reduced margins/paddings)
 * - Small input fields (height and width)
 * - Dynamic field support via generic class selectors
 */

        /* Main Form Layout */
        .admin-content-form {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 12px;
            font-family: "Lucida Grande", "Lucida Sans Unicode", "DejaVu Sans", "Lucida Sans", sans-serif;
            font-size: 13px;
            color: #333;
            max-width: 1200px;
            margin: 0 auto;
            padding: 10px;
            background: #f8f9f9;
        }

        /* Columns */
        .left-column, .right-column {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        /* Fieldsets & Sections */
        fieldset, .entity-fields-wrapper {
            border: 1px solid #ccc;
            padding: 8px 12px 10px 12px;
            margin: 0;
            background: #fff;
            border-radius: 2px;
        }

        legend, summary {
            font-weight: bold;
            padding: 0 5px;
            color: #444;
            font-size: 14px;
        }

        summary {
            cursor: pointer;
            padding: 6px 0;
            list-style: none;
            border-bottom: 1px solid #eee;
            margin-bottom: 6px;
        }

        summary::-webkit-details-marker {
            display: none;
        }

        /* Form Fields - Compact Spacing */
        .form-field {
            margin-bottom: 5px; /* Small space between fields */
            display: flex;
            flex-direction: column;
        }

        /* Inline Checkboxes Fix - Using legacy float/flex for better compatibility */
        .form-field:has(input[type="checkbox"]) {
            display: flex;
            flex-direction: row !important; /* Force row for checkboxes */
            align-items: center;
            gap: 6px;
            margin-bottom: 2px;
        }

        /* Swap label/input order for checkboxes to match Drupal style */
        .form-field:has(input[type="checkbox"]) .form-label {
            order: 2;
            margin-bottom: 0;
            font-weight: normal;
        }

        .form-field:has(input[type="checkbox"]) .form-input {
            order: 1;
        }

        .form-label {
            display: block;
            font-weight: bold;
            margin-bottom: 2px;
            font-size: 12px;
        }

        /* Input Styles - Compact Dimensions */
        input[type="text"],
        input[type="url"],
        input[type="number"],
        input[type="password"],
        select,
        textarea {
            width: 100%;
            max-width: 400px; /* Small width as requested */
            padding: 3px 6px;
            border: 1px solid #bbb;
            border-radius: 2px;
            font-size: 12px;
            box-sizing: border-box;
            line-height: 1.3;
        }

        /* Specific Small Widths for Sidebar */
        .right-column input,
        .right-column select,
        .right-column textarea {
            max-width: 100%; /* Fill sidebar width but sidebar is small */
        }

        /* Compact Heights */
        input[type="text"],
        input[type="url"],
        input[type="number"],
        input[type="password"],
        select {
            height: 26px; /* Small height */
        }

        textarea {
            min-height: 50px;
        }

        textarea.rich-editor {
            min-height: 120px;
            max-width: 100%; /* Content area should be wider */
        }

        /* Checkboxes */
        input[type="checkbox"] {
            margin: 0;
            width: 13px;
            height: 13px;
            vertical-align: middle;
        }

        /* Help Text */
        small {
            display: block;
            color: #666;
            font-size: 11px;
            margin-top: 1px;
        }

        /* Buttons - Drupal Style */
        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 5px;
        }

        .btn-primary, .btn-secondary {
            padding: 4px 12px;
            font-size: 12px;
            font-weight: bold;
            border-radius: 3px;
            cursor: pointer;
            height: 28px;
        }

        .btn-primary {
            background: #0071b3;
            color: white;
            border: 1px solid #005a8e;
        }

        .btn-primary:hover {
            background: #005a8e;
        }

        .btn-secondary {
            background: #efefef;
            color: #333;
            border: 1px solid #ccc;
        }

        /* Dynamic Fields inside .entity-fields-wrapper */
        .entity-fields-wrapper .form-field {
            border-left: 2px solid #e0e0e0;
            padding-left: 8px;
            margin-top: 3px;
        }

        /* Responsive */
        @media (max-width: 800px) {
            .admin-content-form {
                grid-template-columns: 1fr;
            }
        }

    </style>

{% endblock %}

{% block content %}

<div class="admin-page">
    <div class="admin-page-header">
        <h2 class="admin-page-title">{{ page_title }}</h2>
        <div class="admin-page-actions">
            <a href="/admin/content/create" class="admin-button admin-button-outline">
                <i class="admin-icon-arrow-left"></i> Back to Types
            </a>
            <a href="/admin/content" class="admin-button admin-button-outline">
                <i class="admin-icon-list"></i> All Content
            </a>
        </div>
    </div>

    <!-- Content Form - Two Column Layout -->
    <form method="POST" enctype="multipart/form-data" class="admin-content-form">
        <input type="hidden" name="entity_type" value="{{ entity.nodeType }}">
        <input type="hidden" name="id" value="{{ entity.id }}">
        
        <!-- LEFT COLUMN - Large Fields (2fr) -->
        <div class="left-column">
            <!-- Basic Content Fieldset -->
            <fieldset>
                <div class="form-field">
                    <label class="form-label" for="title">Title</label>
                    <div class="form-input">
                        <input type="text" id="title" name="title" value="{{ entity.getTitle() }}" required>
                    </div>
                </div>
            </fieldset>
            
            <!-- Dynamic Fields Block -->
            <fieldset class="entity-fields-wrapper">
                {% block form_html %}{% endblock %}
            </fieldset>
        </div>
        
        <!-- RIGHT COLUMN - Publication & SEO (1fr) -->
        <div class="right-column">
            <!-- Publication Settings Fieldset -->
            <fieldset>
                <legend>Publication Settings</legend>

                <div class="form-field">
                    <label class="form-label" for="status">Status</label>
                    <div class="form-input">
                        <select id="status" name="status" required>
                            <option value="draft" {{ entity.getStatus() == 'draft' ? 'selected' : '' }}>Draft</option>
                            <option value="published" {{ entity.getStatus() == 'published' ? 'selected' : '' }}>Published</option>
                            <option value="archived" {{ entity.getStatus() == 'archived' ? 'selected' : '' }}>Archived</option>
                            <option value="trash" {{ entity.getStatus() == 'trash' ? 'selected' : '' }}>Trash</option>
                        </select>
                    </div>
                </div>

                <div class="form-field">
                    <label class="form-label" for="is_published">Published</label>
                    <div class="form-input">
                        <input type="checkbox" id="is_published" name="is_published" value="1" {{ entity.isPublished() ? 'checked' : '' }}>
                    </div>
                </div>
                
                <div class="form-field">
                    <label class="form-label" for="featured">Featured</label>
                    <div class="form-input">
                        <input type="checkbox" id="featured" name="featured" value="1" {{ entity.getValue('featured') ? 'checked' : '' }}>
                    </div>
                </div>
                
                <div class="form-field">
                    <label class="form-label" for="sticky">Sticky</label>
                    <div class="form-input">
                        <input type="checkbox" id="sticky" name="sticky" value="1" {{ entity.getValue('sticky') ? 'checked' : '' }}>
                    </div>
                </div>

            </fieldset>

            <!-- Actions Fieldset -->
            <fieldset>
                <legend>Actions</legend>
                
                <div class="form-field">
                    <div class="form-input button-group">
                        <input type="submit" name="submit" value="Save {{ entity.nodeType|capitalize }}" class="btn-primary">
                        <input type="button" name="cancel" value="Cancel" class="btn-secondary" onclick="window.history.back();">
                    </div>
                </div>
            </fieldset>
        </div>
    </form>
</div>
{% endblock %}