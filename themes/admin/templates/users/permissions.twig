{% extends "templates/base.twig" %}

{% block title %} {{ page_title }} {% endblock %}

{% block content %}
<form method="post">

    <table class="table table-bordered permissions-table">
        <thead>
            <tr>
                <th>{{"Permission"|upper}}</th>

                {% for role in roles %}
                <th class="text-center">
                    {{ role|replace({'_':' '})|upper }}
                </th>
                {% endfor %}
            </tr>
        </thead>

        <tbody>

            {% for permission_key, permission in all_permissions %}
            <tr>

                <td>
                    <strong>{{ permission.title }}</strong><br>
                    <small>{{ permission.description }}</small>
                </td>

                {% for role in roles %}
                <td class="text-center">
                    
                    <input type="checkbox" name="permissions[{{ role }}][]" value="{{ permission_key }}" {% if
                       permission_key in role_permissions[role] %} checked {% endif %}>

                </td>
                {% endfor %}

            </tr>
            {% endfor %}

        </tbody>
    </table>

    <button type="submit" class="admin-button admin-button-primary">
        Save Permissions
    </button>

</form>
{% endblock %}

{% block head %}

<style>
    .permissions-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        margin-bottom: 1.5rem;
        font-size: 14px;
    }

    .permissions-table th,
    .permissions-table td {
        border: 1px solid #d9dde3;
        padding: 12px;
        vertical-align: top;
    }

    .permissions-table thead th {
        background: #f3f4f6;
        font-weight: 600;
        color: #222;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .permissions-table thead th:first-child {
        text-align: left;
        min-width: 350px;
    }

    .permissions-table tbody tr:nth-child(even) {
        background: #fafafa;
    }

    .permissions-table tbody tr:hover {
        background: #f5f9ff;
    }

    .permissions-table td:first-child {
        width: 40%;
    }

    .permissions-table td strong {
        display: block;
        margin-bottom: 4px;
        color: #222;
        font-weight: 600;
    }

    .permissions-table td small {
        display: block;
        color: #6b7280;
        line-height: 1.4;
    }

    .text-center {
        text-align: center;
        vertical-align: middle !important;
    }

    .permissions-table input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .permissions-table input[type="checkbox"]:hover {
        transform: scale(1.1);
    }

    .btn {
        display: inline-block;
        padding: 10px 18px;
        border: 0;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

    .btn-primary {
        background: #0d77b5;
        color: #fff;
    }

    .btn-primary:hover {
        background: #095a89;
    }

    .permissions-table td:first-child {
        background: #fcfcfc;
    }

    .permissions-table th:not(:first-child),
    .permissions-table td:not(:first-child) {
        width: 100px;
    }

    @media (max-width: 992px) {
        .permissions-table {
            display: block;
            overflow-x: auto;
            white-space: nowrap;
        }

        .permissions-table td:first-child,
        .permissions-table th:first-child {
            min-width: 300px;
        }
    }
</style>

{% endblock %}