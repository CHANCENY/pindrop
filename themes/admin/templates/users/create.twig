{% extends "templates/base.twig" %}

{% block title %}Create User{% endblock %}

{% block content %}
<div class="admin-page">
    <div class="admin-page-header">
        <h2 class="admin-page-title">Create User</h2>
        <p class="admin-page-description">Add a new user account to the system</p>
        <div class="admin-page-actions">
            <a href="/admin/users" class="admin-button admin-button-secondary">
                <i class="admin-icon-arrow-left"></i> Back to Users
            </a>
        </div>
    </div>

    <div class="admin-form-container">
        {% if error %}
        <div class="admin-alert admin-alert-error">
            <i class="admin-icon-alert"></i>
            {{ error }}
        </div>
        {% endif %}

        <form method="POST" class="admin-form">
            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label for="username" class="admin-form-label">Username *</label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        value="{{ data.username|default('') }}"
                        class="admin-form-input" 
                        required 
                        pattern="[a-zA-Z0-9_]{3,20}"
                        title="Username must be 3-20 characters, letters, numbers, and underscores only">
                    <p class="admin-form-help">Choose a unique username (3-20 characters)</p>
                </div>

                <div class="admin-form-group">
                    <label for="email" class="admin-form-label">Email Address *</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        value="{{ data.email|default('') }}"
                        class="admin-form-input" 
                        required>
                    <p class="admin-form-help">User's email address for notifications</p>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label for="password" class="admin-form-label">Password *</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        class="admin-form-input" 
                        required 
                        minlength="8">
                    <p class="admin-form-help">Minimum 8 characters</p>
                </div>

                <div class="admin-form-group">
                    <label for="confirm_password" class="admin-form-label">Confirm Password *</label>
                    <input 
                        type="password" 
                        id="confirm_password" 
                        name="confirm_password" 
                        class="admin-form-input" 
                        required>
                    <p class="admin-form-help">Re-enter password to confirm</p>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label for="role" class="admin-form-label">Role</label>
                    <select id="role" name="role" class="admin-form-select">
                        {% for role_value, role_label in roles %}
                        <option value="{{ role_value }}" {% if data.role|default('user') == role_value %}selected{% endif %}>
                            {{ role_label.label }}
                        </option>
                        {% endfor %}
                    </select>
                    <p class="admin-form-help">User's permission level in the system</p>
                </div>

                <div class="admin-form-group">
                    <label for="status" class="admin-form-label">Status</label>
                    <select id="status" name="status" class="admin-form-select">
                        {% for status_value, status_label in statuses %}
                        <option value="{{ status_value }}" {% if data.status|default('active') == status_value %}selected{% endif %}>
                            {{ status_label }}
                        </option>
                        {% endfor %}
                    </select>
                    <p class="admin-form-help">Account activation status</p>
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-button admin-button-primary">
                    <i class="admin-icon-plus"></i> Create User
                </button>
                <a href="/admin/users" class="admin-button admin-button-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.admin-form');
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirm_password');
    
    form.addEventListener('submit', function(e) {
        if (password.value !== confirmPassword.value) {
            e.preventDefault();
            alert('Passwords do not match!');
            confirmPassword.focus();
            return false;
        }
    });
    
    // Password strength indicator
    password.addEventListener('input', function() {
        const strength = checkPasswordStrength(this.value);
        // You can add password strength UI here
    });
    
    function checkPasswordStrength(password) {
        let strength = 0;
        if (password.length >= 8) strength++;
        if (password.match(/[a-z]/)) strength++;
        if (password.match(/[A-Z]/)) strength++;
        if (password.match(/[0-9]/)) strength++;
        if (password.match(/[^a-zA-Z0-9]/)) strength++;
        return strength;
    }
});
</script>
{% endblock %}
{% endblock %}
