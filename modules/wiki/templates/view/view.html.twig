<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/modules/wiki/assets/wikieditor.css">
<!-- HEADER -->
<header id="sh">
  <a class="logo" href="#">Wiki<em>Edit</em></a>
  <nav style="display:flex;gap:2px"><a href="#">Article</a><a href="#">Discussion</a><a href="#">History</a></nav>
  <div class="ha">
    <button class="hbtn" id="refbtn" onclick="togRef()">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V9"/><polyline points="10,2 14,2 14,6"/><line x1="7" y1="9" x2="14" y2="2"/></svg>
      References
    </button>
    <button class="hbtn" id="srcbtn" onclick="togSrc()">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="5,4 1,8 5,12"/><polyline points="11,4 15,8 11,12"/></svg>
      Source
    </button>
    <button id="dbtn" onclick="exitEdit()">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,8 6,12 14,4"/></svg>
      Done
    </button>
    <button id="ebtn" onclick="enterEdit()">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2l3 3-9 9H2v-3L11 2z"/></svg>
      Edit page
    </button>
  </div>
</header>

<!-- TOOLBAR -->
<div id="tb">
  <select class="tsel" style="width:110px" onchange="fmtBlk(this.value);this.value='p'">
    <option value="p">Format…</option><option value="p">Paragraph</option>
    <option value="h1">Heading 1</option><option value="h2">Heading 2</option>
    <option value="h3">Heading 3</option><option value="h4">Heading 4</option>
    <option value="pre">Code Block</option><option value="blockquote">Blockquote</option>
  </select>
  <select class="tsel" style="width:108px" onchange="applyFont(this.value);this.selectedIndex=0">
    <option>Font…</option><option value="'Source Serif 4',serif">Source Serif</option>
    <option value="'Playfair Display',serif">Playfair</option><option value="'DM Sans',sans-serif">DM Sans</option>
    <option value="'JetBrains Mono',monospace">Mono</option><option value="Georgia,serif">Georgia</option>
  </select>
  <select class="tsel" style="width:58px" onchange="applySize(this.value);this.selectedIndex=0">
    <option>Size…</option><option>12px</option><option>14px</option><option>16px</option>
    <option>18px</option><option>20px</option><option>24px</option><option>28px</option><option>32px</option><option>40px</option>
  </select>
  <div class="ts"></div>
  <button class="tbb" onclick="ex('bold')" title="Bold"><b>B</b></button>
  <button class="tbb" onclick="ex('italic')" title="Italic"><i style="font-family:serif">I</i></button>
  <button class="tbb" onclick="ex('underline')" title="Underline"><u>U</u></button>
  <button class="tbb" onclick="ex('strikeThrough')"><s>S</s></button>
  <button class="tbb" onclick="ex('superscript')" style="font-size:10px">x²</button>
  <button class="tbb" onclick="ex('subscript')" style="font-size:10px">x₂</button>
  <div class="ts"></div>
  <input class="tcol" type="color" value="#1c1a16" title="Text color" oninput="ex('foreColor',this.value)">
  <input class="tcol" type="color" value="#fef08a" title="Highlight" oninput="ex('hiliteColor',this.value)">
  <div class="ts"></div>
  <button class="tbb" onclick="ex('justifyLeft')"><svg viewBox="0 0 16 16"><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="8" x2="10" y2="8"/><line x1="2" y1="12" x2="13" y2="12"/></svg></button>
  <button class="tbb" onclick="ex('justifyCenter')"><svg viewBox="0 0 16 16"><line x1="2" y1="4" x2="14" y2="4"/><line x1="4" y1="8" x2="12" y2="8"/><line x1="3" y1="12" x2="13" y2="12"/></svg></button>
  <button class="tbb" onclick="ex('justifyRight')"><svg viewBox="0 0 16 16"><line x1="2" y1="4" x2="14" y2="4"/><line x1="6" y1="8" x2="14" y2="8"/><line x1="3" y1="12" x2="14" y2="12"/></svg></button>
  <div class="ts"></div>
  <button class="tbb" onclick="ex('insertUnorderedList')"><svg viewBox="0 0 16 16"><circle cx="3" cy="5" r="1.3" fill="currentColor" stroke="none"/><line x1="6" y1="5" x2="14" y2="5"/><circle cx="3" cy="9" r="1.3" fill="currentColor" stroke="none"/><line x1="6" y1="9" x2="14" y2="9"/></svg></button>
  <button class="tbb" onclick="ex('insertOrderedList')"><svg viewBox="0 0 16 16"><text x="1" y="6.5" font-size="6" fill="currentColor" stroke="none" font-family="sans-serif" font-weight="700">1.</text><line x1="7" y1="5" x2="14" y2="5"/><text x="1" y="10.5" font-size="6" fill="currentColor" stroke="none" font-family="sans-serif" font-weight="700">2.</text><line x1="7" y1="9" x2="14" y2="9"/></svg></button>
  <button class="tbb" onclick="ex('outdent')"><svg viewBox="0 0 16 16"><polyline points="7,7 4,9 7,11"/><line x1="8" y1="9" x2="14" y2="9"/><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="14" x2="14" y2="14"/></svg></button>
  <button class="tbb" onclick="ex('indent')"><svg viewBox="0 0 16 16"><polyline points="4,7 7,9 4,11"/><line x1="8" y1="9" x2="14" y2="9"/><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="14" x2="14" y2="14"/></svg></button>
  <div class="ts"></div>
  <button class="tbb" onclick="ex('undo')"><svg viewBox="0 0 16 16"><path d="M3 7a5 5 0 1 1 .9 4.5"/><polyline points="1,4 3,7 6,5"/></svg></button>
  <button class="tbb" onclick="ex('redo')"><svg viewBox="0 0 16 16"><path d="M13 7a5 5 0 1 0-.9 4.5"/><polyline points="15,4 13,7 10,5"/></svg></button>
  <div class="ts"></div>
  <span style="font-size:11px;color:var(--ink3);font-family:var(--fu)">LH</span>
  <input type="range" min="1.2" max="3" step="0.1" value="1.85" style="width:52px;height:18px;accent-color:var(--ea)" oninput="ct.style.lineHeight=this.value;document.getElementById('lhl').textContent=parseFloat(this.value).toFixed(1)">
  <span id="lhl" style="font-size:10px;color:var(--ink3);min-width:20px;font-family:var(--fu)">1.9</span>
  <div class="ts"></div>
  <button class="tbb" onclick="ex('removeFormat')" style="font-size:10px" title="Clear format">Tx</button>
  <div style="flex:1"></div>
  <button class="tbb" onclick="copyHTML()" style="width:auto;padding:0 8px;font-size:11px">Copy HTML</button>
  <button class="tbb" onclick="dlHTML()" style="width:auto;padding:0 8px;font-size:11px">Download</button>
</div>

<!-- PAGE LAYOUT -->
<div id="pw">
  <!-- LEFT TOC -->
  <aside id="toc">
    <h5>Contents</h5>
    <ul id="tocl">{{ wiki.content.toc|raw }}</ul>
    <hr id="toc-sep">
    <div id="toc-actions">
      <div class="toc-add-row">
        <button onclick="tocAddEntry('h2')" title="Add section heading to page">+ Section (H2)</button>
        <button onclick="tocAddEntry('h3')" title="Add sub-section to page">+ Sub-section</button>
      </div>
      <button id="toc-ctoc-btn" onclick="insertCTOCBlock()">📋 Insert Contents block into page</button>
    </div>
  </aside>

  <!-- ARTICLE -->
  <article id="article">
    <div id="am">
      <span class="mtag" style="background:var(--acc-lt);color:var(--acc)">Biology</span>
      <span class="mtag" style="background:#fbeee9;color:#b5451b">Botany</span>
      <span class="mtag" style="background:#eff6ff;color:#1a56db">Featured</span>
      <span class="mdate">Last edited: 19 May 2026</span>
    </div>
    <div id="ct">
     {{ wiki.content.ct|raw }}
    </div>
  </article>

  <!-- RIGHT SIDEBAR -->
  <aside id="rs">
    <div class="ic">
      <div class="ich">Photosynthesis</div>
      <table><tr><td>Type</td><td>Metabolic</td></tr><tr><td>Location</td><td>Chloroplasts</td></tr><tr><td>Inputs</td><td>CO₂, H₂O, light</td></tr><tr><td>Outputs</td><td>Glucose, O₂</td></tr><tr><td>Organisms</td><td>Plants, algae</td></tr></table>
    </div>
    <h5>Related</h5>
    <ul style="list-style:none;font-family:var(--fu);font-size:12px">
      <li style="padding:5px 0;border-bottom:1px solid var(--rule)"><a href="#" style="color:var(--acc);text-decoration:none">Cellular Respiration</a></li>
      <li style="padding:5px 0;border-bottom:1px solid var(--rule)"><a href="#" style="color:var(--acc);text-decoration:none">Chlorophyll</a></li>
      <li style="padding:5px 0"><a href="#" style="color:var(--acc);text-decoration:none">Carbon Cycle</a></li>
    </ul>
  </aside>
</div>

<!-- FLOATING CURSOR + -->
<div id="cplus" title="Insert block here" onclick="openIbar()">+</div>

<!-- INLINE INSERT BAR -->
<div id="ibar">
  <button class="ib" data-tip="Paragraph" onclick="ibDo('p')"><svg viewBox="0 0 16 16"><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="8" x2="11" y2="8"/><line x1="2" y1="12" x2="13" y2="12"/></svg></button>
  <button class="ib" data-tip="Heading 2" onclick="ibDo('h2')"><b style="font-size:11px">H2</b></button>
  <button class="ib" data-tip="Heading 3" onclick="ibDo('h3')"><b style="font-size:10px">H3</b></button>
  <button class="ib" data-tip="Blockquote" onclick="ibDo('quote')"><svg viewBox="0 0 16 16"><path d="M2 7c0-2.8 1.5-4 3.5-4v2C4 5 3.5 5.8 3.5 7H5v4H2V7zm7 0c0-2.8 1.5-4 3.5-4v2c-1.5 0-2 .8-2 2H12v4H9V7z" fill="currentColor" stroke="none"/></svg></button>
  <button class="ib" data-tip="Code block" onclick="ibDo('code')"><svg viewBox="0 0 16 16"><polyline points="5,4 1,8 5,12"/><polyline points="11,4 15,8 11,12"/></svg></button>
  <div class="ibs"></div>
  <button class="ib" data-tip="Bullet list" onclick="ibDo('ul')"><svg viewBox="0 0 16 16"><circle cx="3" cy="5" r="1.3" fill="currentColor" stroke="none"/><line x1="6" y1="5" x2="14" y2="5"/><circle cx="3" cy="9" r="1.3" fill="currentColor" stroke="none"/><line x1="6" y1="9" x2="14" y2="9"/></svg></button>
  <button class="ib" data-tip="Numbered list" onclick="ibDo('ol')"><svg viewBox="0 0 16 16"><text x="1" y="6.5" font-size="6" fill="currentColor" stroke="none" font-family="sans-serif" font-weight="700">1.</text><line x1="7" y1="5" x2="14" y2="5"/><text x="1" y="10.5" font-size="6" fill="currentColor" stroke="none" font-family="sans-serif" font-weight="700">2.</text><line x1="7" y1="9" x2="14" y2="9"/></svg></button>
  <button class="ib" data-tip="Checklist" onclick="ibDo('checklist')"><svg viewBox="0 0 16 16"><rect x="1" y="4" width="5" height="5" rx="1"/><polyline points="2,6.5 3.5,8 5.5,5.5"/><line x1="8" y1="6.5" x2="14" y2="6.5"/><line x1="8" y1="10.5" x2="14" y2="10.5"/></svg></button>
  <div class="ibs"></div>
  <button class="ib" data-tip="Image URL" onclick="ibModal('img-url')"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="1"/><circle cx="5.5" cy="7" r="1.2"/><path d="M1 11l3.5-4 2.5 3 2-2.5 4 5"/></svg></button>
  <button class="ib" data-tip="Upload image" onclick="ibModal('img-up')"><svg viewBox="0 0 16 16"><path d="M4 13H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-2"/><path d="M8 7v6M5 10l3-3 3 3"/></svg></button>
  <button class="ib" data-tip="Video embed" onclick="ibModal('video')"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="1"/><polygon points="6,6 11,8 6,10" fill="currentColor" stroke="none"/></svg></button>
  <button class="ib" data-tip="Audio" onclick="ibModal('audio')"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6"/><polygon points="6,5.5 6,10.5 11,8" fill="currentColor" stroke="none"/></svg></button>
  <button class="ib" data-tip="Link" onclick="ibModal('link')"><svg viewBox="0 0 16 16"><path d="M7 9a3.5 3.5 0 0 0 5 0l2-2a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M9 7a3.5 3.5 0 0 0-5 0L2 9a3.5 3.5 0 0 0 5 5l1-1"/></svg></button>
  <div class="ibs"></div>
  <button class="ib" data-tip="Table" onclick="ibModal('table')"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="1"/><line x1="1" y1="7" x2="15" y2="7"/><line x1="6" y1="2" x2="6" y2="14"/><line x1="11" y1="2" x2="11" y2="14"/></svg></button>
  <button class="ib" data-tip="2 Columns" onclick="ibDo('cols2')"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="6" height="12" rx="1"/><rect x="9" y="2" width="6" height="12" rx="1"/></svg></button>
  <button class="ib" data-tip="Section" onclick="ibDo('sec')"><svg viewBox="0 0 16 16"><rect x="1" y="1" width="14" height="14" rx="2"/><polyline points="5,7 8,10 11,7"/><line x1="4" y1="5" x2="12" y2="5"/></svg></button>
  <button class="ib" data-tip="Form" onclick="ibModal('form')"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="1"/><line x1="4" y1="7" x2="12" y2="7"/><line x1="4" y1="10" x2="8" y2="10"/></svg></button>
  <div class="ibs"></div>
  <button class="ib" data-tip="Info" onclick="ibDo('ci')" style="color:#1a56db">ℹ</button>
  <button class="ib" data-tip="Warning" onclick="ibDo('cw')" style="color:#d97706">⚠</button>
  <button class="ib" data-tip="Divider" onclick="ibDo('hr')"><svg viewBox="0 0 16 16"><line x1="1" y1="8" x2="15" y2="8"/></svg></button>
  <div class="ibs"></div>
  <button class="ib" data-tip="/ Search all blocks" onclick="openSlash()" style="color:var(--ink3);font-size:16px">/</button>
</div>

<!-- SLASH COMMAND MENU -->
<div id="smenu">
  <div id="sinput-wrap">
    <span id="sicon">/</span>
    <input id="sinput" type="text" placeholder="Search blocks — heading, table, form, video…" oninput="filterSlash(this.value)" onkeydown="slashKey(event)">
  </div>
  <div id="slist"></div>
</div>

<!-- INLINE FORMAT POPUP -->
<div id="fp">
  <button class="fpb" onclick="ex('bold')"><b>B</b></button>
  <button class="fpb" onclick="ex('italic')"><i style="font-family:serif">I</i></button>
  <button class="fpb" onclick="ex('underline')"><u>U</u></button>
  <button class="fpb" onclick="ex('strikeThrough')"><s>S</s></button>
  <div class="fps"></div>
  <button class="fpb" onclick="ex('superscript')" style="font-size:10px">x²</button>
  <button class="fpb" onclick="ex('subscript')" style="font-size:10px">x₂</button>
  <div class="fps"></div>
  <input class="fpc" type="color" value="#1c1a16" title="Color" oninput="ex('foreColor',this.value)">
  <input class="fpc" type="color" value="#fef08a" title="Highlight" oninput="ex('hiliteColor',this.value)">
  <div class="fps"></div>
  <button class="fpb" onclick="ibModal('link')" title="Link"><svg viewBox="0 0 16 16"><path d="M7 9a3.5 3.5 0 0 0 5 0l2-2a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M9 7a3.5 3.5 0 0 0-5 0L2 9a3.5 3.5 0 0 0 5 5l1-1"/></svg></button>
  <button class="fpb" onclick="addFootnote()" title="Footnote" style="font-size:10px">fn</button>
  <div class="fps"></div>
  <button class="fpb" onclick="ex('removeFormat')" style="font-size:10px">Tx</button>
</div>

<!-- CONTEXT MENU -->
<div id="ctx">
  <div class="ci-m" onclick="ctxAct('up')"><svg viewBox="0 0 16 16"><polyline points="4,10 8,6 12,10"/></svg> Move up</div>
  <div class="ci-m" onclick="ctxAct('down')"><svg viewBox="0 0 16 16"><polyline points="4,6 8,10 12,6"/></svg> Move down</div>
  <div class="ci-m" onclick="ctxAct('dup')"><svg viewBox="0 0 16 16"><rect x="5" y="1" width="9" height="12" rx="1"/><path d="M3 4H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-1"/></svg> Duplicate</div>
  <hr class="csep">
  <div class="ci-m" onclick="ctxAct('addabove')"><svg viewBox="0 0 16 16"><line x1="8" y1="2" x2="8" y2="10"/><line x1="4" y1="6" x2="12" y2="6"/><line x1="2" y1="13" x2="14" y2="13"/></svg> Add above</div>
  <div class="ci-m" onclick="ctxAct('addbelow')"><svg viewBox="0 0 16 16"><line x1="2" y1="3" x2="14" y2="3"/><line x1="8" y1="6" x2="8" y2="14"/><line x1="4" y1="10" x2="12" y2="10"/></svg> Add below</div>
  <hr class="csep">
  <div class="ci-m danger" onclick="ctxAct('del')"><svg viewBox="0 0 16 16"><polyline points="2,4 14,4"/><path d="M6 4V2h4v2M5 4l1 10h4l1-10"/></svg> Delete block</div>
</div>

<!-- REFERENCES PANEL -->
<div id="refp">
  <div id="rph">
    <span>References</span>
    <button id="rp-ins" onclick="insertRefCursor()">+ Insert at cursor</button>
    <button id="rp-close" style="width:28px;height:28px;background:transparent;border:none;border-radius:50%;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;color:var(--ink3)" onclick="togRef()">×</button>
  </div>
  <div id="rpb"></div>
  <div style="padding:10px 14px;border-top:1px solid var(--rule)">
    <button id="rp-add" onclick="addRef()">+ Add reference</button>
  </div>
</div>

<!-- SOURCE PANEL -->
<div id="sp" onclick="if(event.target===this)closeSrc()">
  <div id="spi">
    <div id="spih">
      <span>HTML Source</span>
      <button class="sbt" onclick="closeSrc()">Discard</button>
      <button class="sbt ok" onclick="applySrc()">Apply</button>
    </div>
    <textarea id="spita" spellcheck="false"></textarea>
  </div>
</div>

<!-- MODAL -->
<div id="mo" onclick="if(event.target===this)closeModal()">
  <div id="mb">
    <h3 id="mtitle">Insert</h3>
    <div id="mbody"></div>
    <div class="mrow">
      <button class="mbt" onclick="closeModal()">Cancel</button>
      <button class="mbt ok" id="mok" onclick="modalOK()">Insert</button>
    </div>
  </div>
</div>

<div id="wcbar">
  <span id="wc-hint" style="color:var(--ea);font-size:11px">✏ Edit mode — click in content to type, press <b>/</b> to insert blocks, or click <b>+</b> next to any line</span>
  <span class="wcs">Words: <b id="wcw">0</b> · Chars: <b id="wcc">0</b></span>
</div>
<div id="tst"></div>

<!-- FOOTNOTE HOVER POPUP -->
<div id="fn-popup">
  <div class="fn-arrow"></div>
  <span class="fn-num" id="fn-num"></span>
  <span class="fn-txt" id="fn-txt"></span>
</div>

<script type="module" src="/themes/admin/assets/js/behavior.js"></script>
<noscript id="wiki-meta" style="display: none;">
    {{ wiki|json_encode|raw }}
</noscript>
<script src="/modules/wiki/assets/editor2.js"></script>